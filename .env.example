DATABASE_URL="mysql://root:@127.0.0.1:3306/agrilink_local"
# Set to required when your managed MySQL provider requires an encrypted connection.
DATABASE_SSL=""
SESSION_SECRET="replace-with-a-long-random-secret"
# One-time first administrator setup. Remove this value after the account is created.
INITIAL_MANAGEMENT_SETUP_SECRET=""
# Set only for the explicit local development seed command; never deploy these values.
DEV_SEED_PASSWORD=""
ALLOW_DEVELOPMENT_SEED=""
SEED_DATABASE_URL="mysql://root:@127.0.0.1:3306/agrilink_local"

# Required only for npm run db:verify / npm run test:run.
# This must point to a MySQL/MariaDB admin database, not the AgriLink application database.
TEST_DATABASE_ADMIN_URL="mysql://root:@127.0.0.1:3306/mysql"
TEST_DATABASE_PREFIX="agrilink_test_"
TEST_DATABASE_ENVIRONMENT="disposable"
